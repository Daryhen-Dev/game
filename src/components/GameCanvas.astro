---
/**
 * Client-only island that mounts the Three.js game renderer.
 * Three.js never runs during SSR/build: the renderer is loaded lazily
 * inside a browser script, after the page reaches the client.
 */
---

<div id="game-root"></div>

<style>
  #game-root {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    box-sizing: border-box;
    overflow: hidden;
    /* Fullscreen portrait game: kill browser touch gestures on the canvas.
       The canvas fills the root edge-to-edge; the HUD overlay (created at
       runtime) applies its own safe-area padding. */
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #game-root canvas {
    display: block;
  }
</style>

<script>
  // Processed and bundled by Astro for the browser (no SSR execution).
  import("../game/boot");
</script>
