---
/**
 * Client-only island that mounts the Phaser game.
 * Phaser never runs during SSR/build: the engine is loaded lazily
 * inside a browser script, after the page reaches the client.
 */
---

<div id="game-root"></div>

<style>
  #game-root {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    box-sizing: border-box;
    /* Fullscreen portrait game: kill browser touch gestures on the canvas. */
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Keep the play area clear of notches and home indicators. */
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
</style>

<script>
  // Processed and bundled by Astro for the browser (no SSR execution).
  import("../game/boot");
</script>
